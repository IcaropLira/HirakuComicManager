{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hiraku Comics Manager",
  "version": "0.1.0",
  "identifier": "com.hiraku.terricola",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hiraku Comics Manager",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNUZFOTJBMTc4QjZBQTgKUldTb2Fvc1hLdWxmVTRhZCsrV1hzT09ueWRkc1h1amlYWjAzWFFzZzR2SGVKWCtENlZtcGFDT2cK",
      "endpoints": [
        "https://github.com/IcaropLira/HirakuComicManager/releases/latest/download/latest.json"
      ]
    }
  }
}
